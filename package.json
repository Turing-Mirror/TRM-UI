{
  "name": "trm-ui",
  "private": false,
  "version": "1.0.0",
  "description": "Turing Mirror shared React components, design tokens and interaction primitives",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Turing-Mirror/TRM-UI.git"
  },
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "test": "vitest run",
    "check:i18n": "node scripts/check_i18n.mjs",
    "build": "eslint . && tsc && node scripts/check_i18n.mjs && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build:lib": "node scripts/build_library.mjs && tsc -p tsconfig.lib.json",
    "prepare": "npm run build:lib"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./styles.css": "./lib/styles/index.css",
    "./tokens.css": "./lib/styles/tokens.css",
    "./components.css": "./lib/styles/components.css",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
