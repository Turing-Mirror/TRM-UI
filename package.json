{
  "name": "trm-ui",
  "private": false,
  "version": "0.1.0",
  "description": "Turing Mirror 桌面产品的 UI/UX 模板：设计令牌、组件库、八语言 i18n",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Turing-Mirror/TRM-UI.git"
  },
